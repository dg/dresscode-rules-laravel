{
	"name": "dresscode/rules-laravel",
	"description": "👔 DressCode rules for Laravel: upgrades code written for older versions of the Laravel framework to the API of the version a project stands on, and reports what has to be rewritten by hand.",
	"keywords": ["laravel", "upgrade", "migration", "deprecations", "refactoring", "modernization", "dresscode"],
	"homepage": "https://dresscode.run",
	"type": "dresscode-extension",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"dresscode/dresscode": "dev-master"
	},
	"require-dev": {
		"larastan/larastan": "^3.0",
		"laravel/framework": "^13.0",
		"nette/phpstan-rules": "^1.0",
		"nette/tester": "^2.6",
		"orchestra/testbench": "^11.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"DressCode\\Laravel\\": "src"
		}
	},
	"scripts": {
		"tester": "tester tests -s",
		"phpstan": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		},
		"dresscode": {
			"extension": "DressCode\\Laravel\\Extension",
			"upgrading": [
				"upgrading/framework.neon",
				"upgrading/framework-attributes.neon"
			]
		}
	}
}
