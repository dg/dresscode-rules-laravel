{
	"name": "dresscode/upgrade-laravel",
	"description": "👔 DressCode Upgrade for Laravel: upgrades code from Laravel 5.8 and later to Laravel 13 and rewrites models, commands and jobs to attributes; the rest is reported with what to write instead.",
	"keywords": ["laravel", "laravel 13", "eloquent", "upgrade", "upgrading", "migration", "deprecations", "refactoring", "codemod", "attributes", "dresscode", "rector", "laravel shift"],
	"homepage": "https://dresscode.run/upgrading-laravel",
	"type": "dresscode-plugin",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"dresscode/dresscode": "^1.2"
	},
	"require-dev": {
		"larastan/larastan": "^3.0",
		"laravel/framework": "^13.0",
		"nette/phpstan-rules": "^1.0",
		"nette/tester": "^2.6",
		"orchestra/testbench": "^11.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"DressCodeUpgrade\\Laravel\\": "src"
		}
	},
	"scripts": {
		"tester": "tester tests -s",
		"phpstan": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		},
		"dresscode": {
			"plugin": "DressCodeUpgrade\\Laravel\\Plugin",
			"upgrading-dir": "upgrading",
			"packages": ["laravel/framework"]
		}
	}
}
