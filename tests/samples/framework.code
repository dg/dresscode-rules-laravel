	public function up(): void
	{
		Schema::create('orders', function (Blueprint $table) {
			$table->double('total', 8, 2);
			$table->double('tax');
			$table->float('weight', 8, 2);
			$table->float('volume', 53);
			$table->unsignedDecimal('price', 10, 2);
			$table->unsignedDecimal('discount');
			$table->unsignedDouble('rate', 8, 2);
			$table->unsignedFloat('ratio');
			$table->point('location');
			$table->multiPolygon('area');
		});
	}
}


class DatabaseReport
{
	public function tables(Connection $connection): array
	{
		$names = [];
		foreach (Schema::getAllTables() as $table) {
			$names[] = $table->name;
		}

		$schema = $connection->getDoctrineSchemaManager();
		$column = $connection->getDoctrineColumn('orders', 'total');
		return [$names, $schema, $column, $connection->getSchemaBuilder()->getAllViews()];
	}


	public function grammar(Connection $connection): MySqlGrammar
	{
		$grammar = new MySqlGrammar;
		$grammar->setConnection($connection);
		PostgresGrammar::cascadeOnTrucate();
		$blueprint = new Blueprint('orders', null, 'app_');
		return $connection->withTablePrefix($grammar);
	}
}


class Order extends Model
{
	use HasVersion7Uuids;
}


class ModelMakeCommand extends GeneratorCommand
{
	protected function getStub(): string
	{
		return __DIR__ . '/stub';
	}


	protected function suggestions(): array
	{
		return $this->possibleModels();
	}
}


class OrderStats
{
	public function describe(Collection $orders, LazyCollection $lines): bool
	{
		return $orders->containsOneItem() || $orders->containsManyItems(fn($order) => $order->paid) || $lines->containsOneItem();
	}
}


class LegacyHelpers
{
	public function slug(array $post): array
	{
		return [
			str_slug($post['title']),
			\str_limit($post['body'], 100),
			\array_get($post, 'author.name', 'anonymous'),
			\studly_case('snake_case'),
			array_map('str_slug', ['A B']),
			\Illuminate\Support\Facades\Input::get('page'),
			\Illuminate\Support\Facades\Input::all(),
			\Illuminate\Support\Facades\Lang::trans('messages.welcome'),
			\Illuminate\Support\Facades\Lang::transChoice('messages.apples', 3),
			trans('messages.welcome'),
		];
	}


	public function relation(\Illuminate\Database\Eloquent\Relations\BelongsTo $relation): string
	{
		return $relation->getRelation();
	}


	public function authorize(): \Illuminate\Auth\Access\Response
	{
		return new \Illuminate\Auth\Access\Response('Allowed');
	}
}


