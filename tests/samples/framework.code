class ProcessPodcast implements \Illuminate\Contracts\Queue\ShouldQueue
{
	use \Illuminate\Foundation\Bus\Dispatchable;

	public $retryAfter = 30;


	public function retryAfter(): int
	{
		return $this->retryAfter;
	}


	public function handle(): void
	{
	}
}


class LegacyController
{
	use \Illuminate\Foundation\Bus\DispatchesJobs;


	public function store(\Illuminate\Database\Eloquent\Model $user, \Illuminate\Support\Collection $items, \Illuminate\Routing\Redirector $redirector): mixed
	{
		ProcessPodcast::dispatchNow();
		$this->dispatchNow(new ProcessPodcast);
		dispatch_now(new ProcessPodcast);
		$user->addHidden('password');
		$items->reduceWithKeys(fn($carry, $item, $key) => $carry + $item, 0);
		$items->until(fn($item) => $item > 3);
		\Illuminate\Support\Facades\Mail::to('a@b.c')->sendNow(new \Illuminate\Mail\Mailable);
		return $redirector->home();
	}
}


class LegacyTest extends \Illuminate\Foundation\Testing\TestCase
{
	use \Illuminate\Foundation\Testing\Concerns\InteractsWithDatabase;


	public function createApplication()
	{
	}


	public function testDeleted(\Illuminate\Database\Eloquent\Model $user, \Illuminate\Foundation\Testing\TestResponse $response): void
	{
		$this->assertDeleted($user);
		$this->assertDeleted('users', ['id' => 1]);
		$response->decodeResponseJson('data');
		\Illuminate\Support\Facades\Notification::assertTimesSent(2, 'App\Notifications\Invoice');
	}
}


