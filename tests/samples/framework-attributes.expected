<?php

namespace App;

use App\Http\Resources\PostResource;
use Illuminate\Bus\Queueable;
use Illuminate\Console\Attributes\Aliases;
use Illuminate\Console\Attributes\Description;
use Illuminate\Console\Attributes\Help;
use Illuminate\Console\Attributes\Signature;
use Illuminate\Console\Command;
use Illuminate\Contracts\Queue\ShouldBeUnique;
use Illuminate\Contracts\Queue\ShouldQueue;
use Illuminate\Database\Eloquent\Attributes\Appends;
use Illuminate\Database\Eloquent\Attributes\CollectedBy;
use Illuminate\Database\Eloquent\Attributes\Connection;
use Illuminate\Database\Eloquent\Attributes\DateFormat;
use Illuminate\Database\Eloquent\Attributes\Fillable;
use Illuminate\Database\Eloquent\Attributes\Guarded;
use Illuminate\Database\Eloquent\Attributes\Hidden;
use Illuminate\Database\Eloquent\Attributes\RouteKey;
use Illuminate\Database\Eloquent\Attributes\Table;
use Illuminate\Database\Eloquent\Attributes\Touches;
use Illuminate\Database\Eloquent\Attributes\Unguarded;
use Illuminate\Database\Eloquent\Attributes\Visible;
use Illuminate\Database\Eloquent\Attributes\WithoutIncrementing;
use Illuminate\Database\Eloquent\Attributes\WithoutTimestamps;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Foundation\Http\Attributes\ErrorBag;
use Illuminate\Foundation\Http\Attributes\StopOnFirstFailure;
use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Http\Resources\Attributes\Collects;
use Illuminate\Http\Resources\Attributes\PreserveKeys;
use Illuminate\Http\Resources\Json\JsonResource;
use Illuminate\Http\Resources\Json\ResourceCollection;
use Illuminate\Queue\Attributes\Backoff;
use Illuminate\Queue\Attributes\Delay;
use Illuminate\Queue\Attributes\DeleteWhenMissingModels;
use Illuminate\Queue\Attributes\FailOnTimeout;
use Illuminate\Queue\Attributes\MaxExceptions;
use Illuminate\Queue\Attributes\Queue;
use Illuminate\Queue\Attributes\Timeout;
use Illuminate\Queue\Attributes\Tries;
use Illuminate\Queue\Attributes\UniqueFor;
use Illuminate\Queue\InteractsWithQueue;


#[WithoutIncrementing]
#[WithoutTimestamps]
#[Table(name: 'blog_posts', key: 'post_id', keyType: 'string')]
#[DateFormat('U')]
#[Connection('blog')]
#[Fillable(['title', 'body'])]
#[Hidden(['secret'])]
#[Visible(['title'])]
#[Appends(['excerpt'])]
#[Touches(['author'])]
#[CollectedBy(PostCollection::class)]
#[RouteKey('slug')]
class Post extends Model
{
	protected function casts(): array
	{
		return [
			'published_at' => 'datetime',
		];
	}
}


#[Unguarded]
class Comment extends Model
{
	public $timestamps = true;


	public function getRouteKeyName()
	{
		return $this->useSlugs ? 'slug' : 'id';
	}
}


#[Table(name: 'tags', key: 'tag_id')]
#[Guarded(['id'])]
class Tag extends Model
{
}


abstract class BaseModel extends Model
{
	protected $connection = 'legacy';
}


class Author extends Model
{
	protected $table = 'authors';


	public function describe(): string
	{
		return "stored in $this->table";
	}
}


class PostCollection extends \Illuminate\Database\Eloquent\Collection
{
}


#[\Illuminate\Console\Attributes\Hidden]
#[Signature('mail:send {user}')]
#[Description('Send a marketing email to a user')]
#[Help('The user is given by the ID')]
#[Aliases(['mail:go'])]
class SendEmails extends Command
{
	public function handle(): void
	{
	}
}


#[StopOnFirstFailure]
#[ErrorBag('post')]
class StorePostRequest extends FormRequest
{
	public function rules(): array
	{
		return ['title' => 'required'];
	}
}


#[Collects(PostResource::class)]
class PostCollectionResource extends ResourceCollection
{
}


#[PreserveKeys]
class PostResourceWithKeys extends JsonResource
{
}


#[FailOnTimeout]
#[DeleteWhenMissingModels]
#[Tries(5)]
#[Timeout(120)]
#[Backoff([10, 60])]
#[MaxExceptions(3)]
#[UniqueFor(3600)]
class ProcessPodcast implements ShouldQueue, ShouldBeUnique
{
	use InteractsWithQueue, Queueable;

	public function handle(): void
	{
	}
}


#[\Illuminate\Queue\Attributes\Connection('sqs')]
#[Queue('listeners')]
#[Delay(60)]
class SendShipmentNotification implements ShouldQueue
{
	public $tries = 3;


	public function handle(object $event): void
	{
		if ($this->tries > 1) {
			return;
		}
	}
}
